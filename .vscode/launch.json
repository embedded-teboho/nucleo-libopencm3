{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (OpenOCD)",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/main.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "configFiles": ["openocd.cfg"],
      "device": "STM32F401RE",
      "svdFile": "path/to/STM32F401.svd",
      "showDevDebugOutput": "raw",
      "preLaunchTask": "build"
    }
  ]
}